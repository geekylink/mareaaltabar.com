# Configuration for /usr/local/bin/marea-deploy.
#
# Install this file as /etc/marea-deploy.env, owned by root and readable by the
# service user (mode 0640 root:mareaalta). The agent reads it through systemd's
# EnvironmentFile=, so values containing spaces are not supported here.

# Required ---------------------------------------------------------------
DEPLOY_REPO=geekylink/mareaaltabar.com
DEPLOY_CHECKOUT=/var/www/marea-alta
DEPLOY_SERVICE=marea-alta

# Optional ---------------------------------------------------------------
# DEPLOY_BRANCH=main
# DEPLOY_GIT_REMOTE=origin
# DEPLOY_WORKFLOW=ci.yml
# DEPLOY_HEALTH_URL=http://127.0.0.1:8000/healthz
# DEPLOY_HEALTH_TIMEOUT=60
# DEPLOY_HEALTH_INTERVAL=2
# DEPLOY_LOCK_FILE=/var/www/marea-alta/.git/marea-deploy.lock
# DEPLOY_STATE_FILE=/var/www/marea-alta/.git/marea-deploy.state

# A fine-grained, read-only GitHub token is only needed when the repository is
# private or the anonymous API quota is too small. Give it Actions: read.
# Store the token in its own file owned by the service user, mode 0600, not in
# this file:
# DEPLOY_GITHUB_TOKEN_FILE=/etc/marea-deploy/github-token
